#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
case "${1:-}" in
  ''|--restart-samba) ;;
  *) printf 'Usage: ./redeploy [--restart-samba]\n' >&2; exit 1 ;;
esac

printf '[redeploy] Pulling latest changes\n'
git pull

./setup "$@"
printf '[redeploy] Complete; configuration and data volumes retained.\n'
