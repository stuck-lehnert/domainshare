#!/usr/bin/env bash
set -Eeuo pipefail

die() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

script_path=${BASH_SOURCE[0]}
case "$script_path" in
  */*) script_dir=${script_path%/*} ;;
  *) script_dir=. ;;
esac

cd "$script_dir/.."
repo_root=$PWD

if command -v podman >/dev/null 2>&1; then
  engine=podman
elif command -v docker >/dev/null 2>&1; then
  engine=docker
else
  die 'podman or docker required'
fi

run_e2e=${DEV_RUN_E2E:-0}
backend=${DEV_BACKEND:-go}
onboarding=0
[[ $# -le 1 ]] || die 'use either --e2e or --onboarding'
case "${1:-}" in
  --e2e) run_e2e=1 ;;
  --onboarding) onboarding=1 ;;
  '') ;;
  *) die "unknown argument: $1" ;;
esac
[[ $onboarding != 1 || $run_e2e != 1 ]] || die '--onboarding cannot be combined with DEV_RUN_E2E=1'
case "$backend" in
  python|go) ;;
  upgrade) [[ $run_e2e == 1 ]] || die 'DEV_BACKEND=upgrade requires --e2e' ;;
  split)
    [[ $run_e2e == 1 ]] || die 'DEV_BACKEND=split requires --e2e'
    docker compose version >/dev/null || die 'DEV_BACKEND=split requires Docker Compose'
    engine=docker
    ;;
  *) die 'DEV_BACKEND must be python, go, upgrade, or split' ;;
esac
go_command=(/usr/local/bin/domainshare supervise --native)
python_command=(python3 /app/entrypoint.py)
legacy_revision=88f803daf29313571ff0266a421ed261015e2142

dev_realm=${DEV_REALM:-DEV.TEST}
dev_workgroup=${DEV_WORKGROUP:-DEV}
dev_dns_domain=${DEV_DNS_DOMAIN:-dev.test}
dev_base_dn=${DEV_BASE_DN:-DC=dev,DC=test}
dev_web_hostname=${DEV_WEB_HOSTNAME:-files.localhost}
dev_dc_password=${DEV_DC_PASSWORD:-PreviewDc123!}
dev_user_password=${DEV_USER_PASSWORD:-PreviewUser123!}
dev_admin_user=${DEV_ADMIN_USER:-previewadmin}
dev_admin_password=${DEV_ADMIN_PASSWORD:-PreviewAdmin123!}
dev_backup_user=${DEV_BACKUP_USER:-preview}
dev_backup_password=${DEV_BACKUP_PASSWORD:-PreviewBackup123!}
dev_archive_password=${DEV_ARCHIVE_PASSWORD:-PreviewArchive123!}
dev_backup_auto_enabled=${DEV_BACKUP_AUTO_ENABLED:-true}
dev_ca_password=${DEV_CA_PASSWORD:-PreviewCa123!}
dev_ca_provisioner=${DEV_CA_PROVISIONER:-preview}
dev_https_port=${DEV_HTTPS_PORT:-8443}
dev_http_port=${DEV_HTTP_PORT:-8080}
dev_activity_interval=${DEV_ACTIVITY_INTERVAL_SECONDS:-4}
dev_backup_interval=${DEV_BACKUP_INTERVAL_SECONDS:-120}

server_image=${DEV_SERVER_IMAGE:-domainshare-dev:latest}
python_image=${DEV_PYTHON_IMAGE:-domainshare-python-dev:latest}
ad_image=${DEV_AD_IMAGE:-domainshare-ad-dev:latest}
backup_image=${DEV_BACKUP_IMAGE:-domainshare-backup-dev:latest}
ca_image=${DEV_CA_IMAGE:-docker.io/smallstep/step-ca:latest}

run_id="domainshare-dev-$$-$RANDOM"
network_name="$run_id-net"
dc_container="$run_id-dc"
ca_container="$run_id-ca"
backup_container="$run_id-backup"
files_container="$run_id-files"
management_container="$run_id-management"
client_container="$run_id-client"
restore_container="$run_id-restore"

ca_volume="$run_id-ca-state"
backup_volume="$run_id-backup-data"
private_volume="$run_id-private-data"
fslogix_volume="$run_id-fslogix-data"
groups_volume="$run_id-group-data"
state_volume="$run_id-state-data"
samba_volume="$run_id-samba-lib"

containers=(
  "$restore_container"
  "$client_container"
  "$files_container"
  "$dc_container"
  "$backup_container"
  "$ca_container"
)
volumes=(
  "$ca_volume"
  "$backup_volume"
  "$private_volume"
  "$fslogix_volume"
  "$groups_volume"
  "$state_volume"
  "$samba_volume"
)

network_created=0
watchdog_pid=
log_pid=
server_wait_pid=
backup_driver_pid=
ca_root_file=
upgrade_fixture=
preview_compose=
split_volumes=()
legacy_source=
legacy_container="$run_id-legacy"
samba_container="$run_id-files"

if [[ $backend == split ]]; then
  containers=("$management_container" "$legacy_container" "${containers[@]}")
  files_container=$legacy_container
  for volume in samba_conf samba_run samba_cache samba_logs samba_readiness; do
    split_volumes+=("${run_id}_$volume")
  done
fi

stop_resources() {
  local container
  local volume
  for container in "${containers[@]}"; do
    "$engine" stop -t 3 "$container" >/dev/null 2>&1 || true
  done
  for container in "${containers[@]}"; do
    "$engine" rm -f "$container" >/dev/null 2>&1 || true
  done
  if [[ $network_created == 1 ]]; then
    "$engine" network rm "$network_name" >/dev/null 2>&1 || true
  fi
  for volume in "${volumes[@]}" "${split_volumes[@]}"; do
    "$engine" volume rm "$volume" >/dev/null 2>&1 || true
  done
}

start_watchdog() {
  local parent_pid=$$
  (
    while kill -0 "$parent_pid" >/dev/null 2>&1; do
      sleep 1
    done
    stop_resources
  ) &
  watchdog_pid=$!
}

cleanup() {
  local status=$?
  trap - EXIT INT TERM HUP QUIT

  if [[ -n ${backup_driver_pid:-} ]]; then
    kill "$backup_driver_pid" >/dev/null 2>&1 || true
    wait "$backup_driver_pid" 2>/dev/null || true
  fi
  if [[ -n ${log_pid:-} ]]; then
    kill "$log_pid" >/dev/null 2>&1 || true
    wait "$log_pid" 2>/dev/null || true
  fi
  if [[ -n ${server_wait_pid:-} ]]; then
    kill "$server_wait_pid" >/dev/null 2>&1 || true
    wait "$server_wait_pid" 2>/dev/null || true
  fi
  if [[ -n ${watchdog_pid:-} ]]; then
    kill "$watchdog_pid" >/dev/null 2>&1 || true
    wait "$watchdog_pid" 2>/dev/null || true
  fi

  stop_resources
  if [[ -n ${ca_root_file:-} && -f $ca_root_file ]]; then
    rm -f -- "$ca_root_file"
  fi
  if [[ -n $upgrade_fixture ]]; then
    rm -f -- "$upgrade_fixture"
  fi
  if [[ -n $preview_compose ]]; then
    rm -f -- "$preview_compose"
  fi
  if [[ -n $legacy_source ]]; then
    rm -rf -- "$legacy_source"
  fi
  exit "$status"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'exit 131' QUIT

show_logs() {
  local container
  for container in "$dc_container" "$ca_container" "$backup_container" "$legacy_container" "$samba_container" "$management_container" "$client_container"; do
    if "$engine" inspect "$container" >/dev/null 2>&1; then
      printf '\n===== %s =====\n' "$container" >&2
      "$engine" logs --tail 160 "$container" >&2 || true
      if [[ $container == "$files_container" ]]; then
        "$engine" exec "$container" cat /state/services-status.json >&2 || true
      fi
    fi
  done
}

wait_for_exec() {
  local container=$1
  local seconds=$2
  shift 2
  local elapsed=0
  while (( elapsed < seconds )); do
    if "$engine" exec "$container" "$@" >/dev/null 2>&1; then
      return 0
    fi
    if [[ $("$engine" inspect -f '{{.State.Running}}' "$container" 2>/dev/null || true) != true ]]; then
      return 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

follow_server() {
  local file_status
  "$engine" logs -f "$files_container" &
  log_pid=$!
  # Bash can handle termination immediately while waiting on a background job.
  "$engine" wait "$files_container" >/dev/null 2>&1 &
  server_wait_pid=$!
  wait "$server_wait_pid" || die 'unable to wait for the file server'
  server_wait_pid=
  file_status=$("$engine" inspect -f '{{.State.ExitCode}}' "$files_container" 2>/dev/null || printf '1')
  case "$file_status" in
    ''|*[!0-9]*) exit 1 ;;
    *) exit "$file_status" ;;
  esac
}

create_network() {
  local attempt
  local second
  local third
  for attempt in $(seq 0 31); do
    second=$((20 + ((RANDOM + attempt) % 10)))
    third=$(((RANDOM + $$ + attempt) % 240 + 8))
    subnet="172.${second}.${third}.0/24"
    if "$engine" network create --subnet "$subnet" "$network_name" >/dev/null 2>&1; then
      network_created=1
      subnet_prefix="172.${second}.${third}."
      return 0
    fi
  done
  return 1
}

start_watchdog

printf 'engine: %s\n' "$engine"
if [[ ${DEV_SKIP_BUILD:-0} != 1 ]]; then
  printf 'building file server image: %s\n' "$server_image"
  "$engine" build -t "$server_image" -f "$repo_root/Dockerfile" "$repo_root"
  if [[ $backend == split ]]; then
    printf 'building the deployed legacy revision: %s\n' "$legacy_revision"
    legacy_source=$(mktemp -d)
    git archive "$legacy_revision" | tar -x -C "$legacy_source"
    "$engine" build -t "$python_image" -f "$legacy_source/Dockerfile" "$legacy_source"
  elif [[ $backend != go ]]; then
    printf 'building the Python compatibility image: %s\n' "$python_image"
    "$engine" build --target python-compat -t "$python_image" -f "$repo_root/Dockerfile" "$repo_root"
  fi
  printf 'building AD/client image: %s\n' "$ad_image"
  "$engine" build -t "$ad_image" -f "$repo_root/dev/ad-dc.Dockerfile" "$repo_root"
  printf 'building backup image: %s\n' "$backup_image"
  "$engine" build -t "$backup_image" -f "$repo_root/dev/backup.Dockerfile" "$repo_root"
fi

printf 'creating isolated network: %s\n' "$network_name"
create_network || die 'unable to allocate an isolated container subnet'
dc_ip="${subnet_prefix}10"
ca_ip="${subnet_prefix}20"
files_ip="${subnet_prefix}30"
backup_ip="${subnet_prefix}40"

for volume in "${volumes[@]}"; do
  "$engine" volume create "$volume" >/dev/null
done

printf 'starting local CA: %s\n' "$ca_image"
"$engine" run -d \
  --name "$ca_container" \
  --hostname "ca.${dev_dns_domain}" \
  --network "$network_name" \
  --ip "$ca_ip" \
  --add-host "${dev_web_hostname}:${files_ip}" \
  -e "DOCKER_STEPCA_INIT_NAME=DomainShare preview CA" \
  -e "DOCKER_STEPCA_INIT_DNS_NAMES=ca.${dev_dns_domain},localhost,127.0.0.1" \
  -e "DOCKER_STEPCA_INIT_PROVISIONER_NAME=${dev_ca_provisioner}" \
  -e "DOCKER_STEPCA_INIT_PASSWORD=${dev_ca_password}" \
  -e "DOCKER_STEPCA_INIT_ACME=true" \
  -v "$ca_volume:/home/step" \
  "$ca_image" >/dev/null

if ! wait_for_exec "$ca_container" 120 step ca health \
  --ca-url=https://localhost:9000 \
  --root=/home/step/certs/root_ca.crt; then
  show_logs
  die 'local CA did not become healthy'
fi
preview_tmp_root=${TMPDIR:-/tmp}
ca_root_file="${preview_tmp_root%/}/${run_id}-root-ca.crt"
"$engine" exec "$ca_container" cat /home/step/certs/root_ca.crt > "$ca_root_file"

printf 'starting disposable rsync backup target\n'
"$engine" run -d \
  --name "$backup_container" \
  --hostname "backup.${dev_dns_domain}" \
  --network "$network_name" \
  --ip "$backup_ip" \
  -e "BACKUP_USERNAME=${dev_backup_user}" \
  -e "BACKUP_PASSWORD=${dev_backup_password}" \
  -e "PREVIEW_ARCHIVE_PASSWORD=${dev_archive_password}" \
  -v "$backup_volume:/backup" \
  "$backup_image" >/dev/null

printf 'starting disposable Samba AD DC: %s\n' "$dev_realm"
"$engine" run -d \
  --name "$dc_container" \
  --hostname "dc.${dev_dns_domain}" \
  --network "$network_name" \
  --ip "$dc_ip" \
  -e "AD_REALM=${dev_realm}" \
  -e "AD_DOMAIN=${dev_workgroup}" \
  -e "AD_DNS_DOMAIN=${dev_dns_domain}" \
  -e "AD_BASE_DN=${dev_base_dn}" \
  -e "AD_ADMIN_PASSWORD=${dev_dc_password}" \
  -e "AD_USER_PASSWORD=${dev_user_password}" \
  -e "AD_WEB_ADMIN_USER=${dev_admin_user}" \
  -e "AD_WEB_ADMIN_PASSWORD=${dev_admin_password}" \
  -e "DEV_CA_IP=${ca_ip}" \
  -e "DEV_BACKUP_IP=${backup_ip}" \
  -e "DEV_FILESERVER_IP=${files_ip}" \
  "$ad_image" >/dev/null

if ! wait_for_exec "$dc_container" 150 test -f /run/preview-ready; then
  show_logs
  die 'dummy AD domain did not become ready'
fi
domain_sid=$("$engine" exec "$dc_container" cat /run/domain-sid)
smb_users_sid="${domain_sid}-513"
if [[ $run_e2e == 1 ]]; then
  smb_users_sid=$("$engine" exec "$dc_container" samba-tool group show 'Preview SMB Users' | sed -n 's/^objectSid: //p')
  [[ "$smb_users_sid" == "${domain_sid}"-[0-9]* ]] || die 'unable to resolve the preview SMB users group SID'
fi

if [[ $onboarding == 1 ]]; then
  printf 'starting fresh file server for HTTP-to-HTTPS onboarding (%s)\n' "$backend"
  onboarding_image=$python_image
  onboarding_command=("${python_command[@]}")
  if [[ $backend == go ]]; then
    onboarding_image=$server_image
    onboarding_command=("${go_command[@]}")
  fi

  "$engine" run -d \
    --name "$files_container" \
    --hostname files \
    --network "$network_name" \
    --ip "$files_ip" \
    --dns "$dc_ip" \
    --dns-search "$dev_dns_domain" \
    -p "127.0.0.1:${dev_http_port}:80" \
    -p "127.0.0.1:${dev_https_port}:8443" \
    -v "$private_volume:/data/private" \
    -v "$fslogix_volume:/data/fslogix" \
    -v "$groups_volume:/data/groups" \
    -v "$state_volume:/state" \
    -v "$samba_volume:/var/lib/samba" \
    "$onboarding_image" python3 -c '
import os
import sqlite3
import subprocess
import sys

# Only the external port mapping is supplied by the launcher. Domain, TLS,
# credentials, groups and backups remain unconfigured until entered in the UI.
port = int(sys.argv[1])
if not 1 <= port <= 65535:
    raise ValueError("Invalid development HTTPS port")

if sys.argv[2] == "python3":
    sys.path.insert(0, "/app")
    import configuration
    configuration.Store()
else:
    subprocess.run(["domainshare", "export-shell"], stdout=subprocess.DEVNULL, check=True)

with sqlite3.connect("/state/configuration.db") as conn:
    conn.execute("UPDATE configuration SET settings=json_set(settings, ?, ?) WHERE id=1", ("$.WEB_HTTPS_PORT", str(port)))

os.execvp(sys.argv[2], sys.argv[2:])
' "$dev_https_port" "${onboarding_command[@]}" >/dev/null
else
  printf 'seeding preview files\n'
  # Give the synthetic Private folders the same UIDs as the member server's
  # RID mapping. Go must not transfer a pre-existing home to a new AD account.
  private_owners=()
  read -r private_uid_range < <(awk '$1 == "idmap" && $2 == "config" && $3 != "*" && $5 == "range" { print $7 }' "$repo_root/etc/samba/smb.conf")
  private_uid_base=${private_uid_range%-*}
  [[ $private_uid_base =~ ^[1-9][0-9]+$ ]] || die 'unable to determine the preview RID range'

  for account in alice bob carol dave eve; do
    account_sid=$("$engine" exec "$dc_container" samba-tool user show "$account" | sed -n 's/^objectSid: //p')
    rid=${account_sid#"${domain_sid}"-}
    [[ $rid =~ ^[0-9]+$ ]] || die "unable to resolve preview SID for $account"
    private_owners+=("$account:$((private_uid_base + 10#$rid))")
  done

  "$engine" run --rm \
    --network "$network_name" \
    -e "DEV_SEED_MB=${DEV_SEED_MB:-8}" \
    -v "$private_volume:/data/private" \
    -v "$fslogix_volume:/data/fslogix" \
    -v "$groups_volume:/data/groups" \
    -v "$state_volume:/state" \
    --entrypoint /usr/local/bin/preview-seed-files \
    "$ad_image" "${private_owners[@]}"

  start_files_server() {
  local image=$1
  shift
  local labels=()
  if [[ $backend == split ]]; then
    labels=(--label "com.docker.compose.project=$run_id" --label com.docker.compose.service=samba
      --label com.docker.compose.container-number=1 --label com.docker.compose.oneoff=False
      --label com.docker.compose.config-hash=legacy)
  fi
  "$engine" run -d \
    "${labels[@]}" \
    --name "$files_container" \
    --hostname files \
    --network "$network_name" \
    --ip "$files_ip" \
    --dns "$dc_ip" \
    --dns-search "$dev_dns_domain" \
    -p "127.0.0.1:${dev_https_port}:8443" \
    -e "REALM=${dev_realm}" \
    -e "WORKGROUP=${dev_workgroup}" \
    -e "DOMAIN=dc.${dev_dns_domain}" \
    -e "LDAP_URI=ldap://dc.${dev_dns_domain}" \
    -e "LDAP_BASE_DN=${dev_base_dn}" \
    -e "JOIN_USER=Administrator" \
    -e "JOIN_PASSWORD=${dev_dc_password}" \
    -e "DOMAIN_USERS_SID=${smb_users_sid}" \
    -e "DOMAIN_ADMINS_SID=${domain_sid}-512" \
    -e "FSLOGIX_GROUP_SID=${smb_users_sid}" \
    -e "SAMBA_HOSTNAME=files" \
    -e "NETBIOS_NAME=FILES" \
    -e "AD_DNS_NAME=files.${dev_dns_domain}" \
    -e "WEB_ENABLED=true" \
    -e "WEB_HOSTNAME=${dev_web_hostname}" \
    -e "WEB_BIND_PORT=8443" \
    -e "WEB_HTTPS_PORT=${dev_https_port}" \
    -e "WEB_LOGIN_ATTEMPTS_PER_5_MIN=100" \
    -e "WEB_LOGIN_ACCOUNT_ATTEMPTS_PER_5_MIN=100" \
    -e "WEB_JWT_SECRET=preview-only-jwt-secret-with-at-least-32-bytes" \
    -e "WEB_TLS_MODE=acme" \
    -e "ACME_CA_SERVER=https://ca.${dev_dns_domain}:9000/acme/acme/directory" \
    -e "ACME_CA_CERTIFICATES=/state/tls/acme-ca-certificates.pem" \
    -e "ACME_CA_CERTIFICATES_URL=https://ca.${dev_dns_domain}:9000/roots.pem" \
    -e "ACME_CA_CERTIFICATES_INSECURE_DOWNLOAD=true" \
    -e "ACME_HTTP_LISTEN=:80" \
    -e "WEB_USAGE_SCAN_INTERVAL_SECONDS=60" \
    -e "WEB_DIRECTORY_CACHE_SECONDS=30" \
    -e "AUDIT_POLL_SECONDS=0.25" \
    -e "BACKUP_DESTINATION=rsync://${dev_backup_user}:${dev_backup_password}@backup.${dev_dns_domain}/backups/fileserver" \
    -e "BACKUP_ARCHIVE_PASSWORD=${dev_archive_password}" \
    -e "BACKUP_AUTO_ENABLED=${dev_backup_auto_enabled}" \
    -e "BACKUP_PROGRESS=never" \
    -e "BACKUP_PROGRESS_INTERVAL_SECONDS=1" \
    -e "BACKUP_RETENTION_DAILY=3" \
    -e "BACKUP_RETENTION_WEEKLY=2" \
    -e "BACKUP_RETENTION_MONTHLY=1" \
    -e "BACKUP_RETENTION_YEARLY=1" \
    -v "$private_volume:/data/private" \
    -v "$fslogix_volume:/data/fslogix" \
    -v "$groups_volume:/data/groups" \
    -v "$state_volume:/state" \
    -v "$samba_volume:/var/lib/samba" \
    "$image" "$@" >/dev/null
  }

  printf 'starting actual file server and HTTPS web UI (%s)\n' "$backend"
  if [[ $backend == go ]]; then
    start_files_server "$server_image"
  else
    start_files_server "$python_image"
  fi
fi

health_command=(python3 /app/healthcheck.py)
if [[ $backend == go ]]; then
  health_command=(/usr/local/bin/domainshare healthcheck)
fi

if ! wait_for_exec "$files_container" 240 "${health_command[@]}"; then
  show_logs
  die 'file server web UI did not become healthy'
fi

if [[ $onboarding == 1 ]]; then
  if ! wait_for_exec "$files_container" 30 python3 -c \
    'import urllib.request; assert urllib.request.urlopen("http://127.0.0.1/api/https/status", timeout=3).status == 200'; then
    show_logs
    die 'HTTP HTTPS-setup UI did not become ready'
  fi
  printf '\nOnboarding preview ready (fresh configuration; no automatic domain join)\n'
  printf '  Start here:        http://%s:%s/\n' "$dev_web_hostname" "$dev_http_port"
  printf '  HTTPS afterwards:  https://%s:%s/\n' "$dev_web_hostname" "$dev_https_port"
  printf '  HTTPS setup code:  %s\n' "$("$engine" exec "$files_container" cat /state/https-setup-code)"
  printf '  Setup code:        %s\n' "$("$engine" exec "$files_container" cat /state/setup-code)"
  printf '\nStep 1 — HTTP: configure ACME and upload the disposable CA root\n'
  printf '  HTTPS hostname:    %s\n' "$dev_web_hostname"
  printf '  ACME directory:    https://ca.%s:9000/acme/acme/directory\n' "$dev_dns_domain"
  printf '  CA root to upload: %s\n' "$ca_root_file"
  printf '\nStep 2 — HTTPS: join the disposable domain and select groups\n'
  printf '  Realm / NetBIOS:   %s / %s\n' "$dev_realm" "$dev_workgroup"
  printf '  Domain controller: dc.%s\n' "$dev_dns_domain"
  printf '  Join account:      Administrator / %s\n' "$dev_dc_password"
  printf '  Server / NetBIOS:  files / FILES\n'
  printf '  Advanced LDAP URI: ldap://dc.%s (development DC only)\n' "$dev_dns_domain"
  printf '  User / Admin group: Domain Users / Domain Admins\n'
  printf '  Initial admin:     %s\\%s / %s\n' "$dev_workgroup" "$dev_admin_user" "$dev_admin_password"
  printf '\nOptional backup destination — configure under /admin/settings after setup\n'
  printf '  Destination:       rsync://%s:%s@backup.%s/backups/fileserver\n' "$dev_backup_user" "$dev_backup_password" "$dev_dns_domain"
  printf '\nTrust the disposable CA root temporarily before continuing over HTTPS.\n'
  printf 'Files, permissions and backups start empty; no SMB traffic or backup driver is started.\n'
  printf 'Press Ctrl-C to remove this run, including its configuration and test data.\n\n'
  follow_server
fi

if [[ $run_e2e == 1 ]]; then
  printf 'validating one-time untrusted CA root retrieval across a restart\n'
  initial_ca_bundle_stat=$("$engine" exec "$files_container" stat -c '%i:%s:%Y' /state/tls/acme-ca-certificates.pem)
  "$engine" restart "$files_container" >/dev/null
  if ! wait_for_exec "$files_container" 240 "${health_command[@]}"; then
    show_logs
    die 'file server web UI did not become healthy after the one-time CA download restart check'
  fi
  restarted_ca_bundle_stat=$("$engine" exec "$files_container" stat -c '%i:%s:%Y' /state/tls/acme-ca-certificates.pem)
  if [[ "$initial_ca_bundle_stat" != "$restarted_ca_bundle_stat" ]]; then
    show_logs
    die 'persisted ACME CA certificate bundle changed during restart'
  fi
  ca_bundle_download_count=$("$engine" logs "$files_container" 2>&1 | awk '/Stored the initial ACME CA certificate bundle/ { count++ } END { print count + 0 }')
  if [[ "$ca_bundle_download_count" != 1 ]]; then
    show_logs
    die "expected exactly one ACME CA certificate download, got ${ca_bundle_download_count}"
  fi
fi

printf 'starting continuous authenticated SMB activity client\n'
"$engine" run -d \
  --name "$client_container" \
  --hostname preview-client \
  --network "$network_name" \
  --dns "$dc_ip" \
  --dns-search "$dev_dns_domain" \
  --add-host "files.${dev_dns_domain}:${files_ip}" \
  -e "AD_DOMAIN=${dev_workgroup}" \
  -e "AD_USER_PASSWORD=${dev_user_password}" \
  -e "FILESERVER_HOST=files.${dev_dns_domain}" \
  -e "DEV_ACTIVITY_INTERVAL_SECONDS=${dev_activity_interval}" \
  "$ad_image" /usr/local/bin/preview-client >/dev/null

if ! wait_for_exec "$client_container" 120 test -f /run/preview-client-ready; then
  show_logs
  die 'preview SMB client did not complete its initial activity'
fi

run_e2e_checks() {
  PREVIEW_ENGINE="$engine" \
    PREVIEW_BACKEND="$backend" \
    PREVIEW_FILES_CONTAINER="$files_container" \
    PREVIEW_CLIENT_CONTAINER="$client_container" \
    PREVIEW_BACKUP_CONTAINER="$backup_container" \
    PREVIEW_CA_ROOT="$ca_root_file" \
    PREVIEW_HTTPS_PORT="$dev_https_port" \
    PREVIEW_HTTPS_HOST="$dev_web_hostname" \
    PREVIEW_REALM="$dev_realm" \
    PREVIEW_WORKGROUP="$dev_workgroup" \
    PREVIEW_DNS_DOMAIN="$dev_dns_domain" \
    PREVIEW_DOMAIN_SID="$domain_sid" \
    PREVIEW_ADMIN_USER="$dev_admin_user" \
    PREVIEW_ADMIN_PASSWORD="$dev_admin_password" \
    PREVIEW_USER_PASSWORD="$dev_user_password" \
    python3 "$repo_root/dev/e2e.py" "$@"
}

if [[ $backend == upgrade || $backend == split ]]; then
  upgrade_fixture=$(mktemp)
  if ! run_e2e_checks --prepare-upgrade "$upgrade_fixture"; then
    show_logs
    die 'failed to prepare Python upgrade fixtures'
  fi

  printf 'switching the disposable Python server to Go on the same AD account and volumes\n'
  if [[ $backend == split ]]; then
    preview_compose=$(mktemp --suffix=.json)
    COMPOSE_PROJECT_NAME="$run_id" docker compose -f "$repo_root/docker-compose.yml" --profile tools config --format json |
      python3 "$repo_root/dev/split-compose.py" "$network_name" "$files_ip" "${subnet_prefix}31" \
        "$dc_ip" "$dev_dns_domain" "$dev_https_port" "$samba_container" "$management_container" "$server_image" \
        "$private_volume" "$fslogix_volume" "$groups_volume" "$state_volume" "$samba_volume" > "$preview_compose"
    export COMPOSE_FILE="$preview_compose" COMPOSE_PROJECT_NAME="$run_id" PREVIEW_SAMBA_CONTAINER="$samba_container"
    if ! "$repo_root/setup" --skip-build; then
      show_logs
      die 'Compose split migration failed'
    fi
    files_container=$management_container
  else
    "$engine" stop --time 30 "$files_container" >/dev/null
    "$engine" rm "$files_container" >/dev/null
    start_files_server "$server_image"
  fi
  if ! wait_for_exec "$files_container" 240 /usr/local/bin/domainshare healthcheck; then
    show_logs
    die 'Go backend did not become healthy with the existing Python volumes'
  fi
  upgraded_ca_bundle_stat=$("$engine" exec "$files_container" stat -c '%i:%s:%Y' /state/tls/acme-ca-certificates.pem)
  [[ "$restarted_ca_bundle_stat" == "$upgraded_ca_bundle_stat" ]] || die 'upgrade replaced the persisted CA bundle'

  if ! run_e2e_checks --verify-upgrade "$upgrade_fixture"; then
    show_logs
    die 'Go could not read live state created by Python'
  fi

  if [[ $backend == split ]] && ! run_e2e_checks --verify-redeploy; then
    show_logs
    die 'management redeploy interrupted SMB'
  fi
fi

run_backup_loop() {
  local elapsed
  while "$engine" inspect "$files_container" >/dev/null 2>&1; do
    if [[ $backend == python ]]; then
      "$engine" exec "$files_container" /bin/bash -lc \
        'source /app/runtime.env && BACKUP_TRIGGER=automatic exec /usr/bin/python3 /app/backup_to_destination.py' || true
    else
      "$engine" exec "$files_container" /usr/local/bin/domainshare backup || true
    fi
    elapsed=0
    while (( elapsed < dev_backup_interval )); do
      "$engine" inspect "$files_container" >/dev/null 2>&1 || return 0
      sleep 1
      elapsed=$((elapsed + 1))
    done
  done
}
run_backup_loop &
backup_driver_pid=$!

check_backup_restore() {
  printf 'restoring a completed remote backup in an isolated container\n'
  "$engine" run --rm --name "$restore_container" --network none \
    -v "$backup_volume:/backup:ro" \
    -e "PREVIEW_ARCHIVE_PASSWORD=$dev_archive_password" \
    --entrypoint /bin/sh "$server_image" -ec '
      archive=
      for marker in /backup/fileserver/snapshots/*/.backup_complete; do
        candidate="${marker%/*}/data/groups/data/Finance.7z"
        if [ -f "$marker" ] && [ -f "$candidate" ]; then
          archive=$candidate
        fi
      done
      test -n "$archive"
      export archive

      output=$(printf "%s\n" "$PREVIEW_ARCHIVE_PASSWORD" |
        timeout 120 script -qe -E never -c '\''domainshare-backup restore --legacy "$archive" /tmp/recovered'\'' /dev/null)
      case "$output" in
        *"$PREVIEW_ARCHIVE_PASSWORD"*) echo "restore echoed its password" >&2; exit 1 ;;
      esac

      printf "Quarter,Forecast\nQ1,120000\nQ2,135000\n" |
        cmp - /tmp/recovered/Finance/Reports/forecast.csv
    '
}

if [[ $run_e2e == 1 ]]; then
  if [[ $backend != python ]]; then
    "$engine" exec "$files_container" test ! -e /app/entrypoint.py
    "$engine" exec "$files_container" test ! -e /app/runtime.env

    # Only the tests use these modules to synthesize on-disk state from old
    # versions. The default image and its startup contain no Python backend.
    fixture_path=/tmp/domainshare-legacy-fixture
    "$engine" exec "$files_container" mkdir -m 700 "$fixture_path"
    for module in access_control account_policy reconcile_shares state_db; do
      "$engine" cp "$repo_root/app/$module.py" "$files_container:$fixture_path/$module.py"
    done
  fi

  printf 'running end-to-end assertions\n'
  if ! run_e2e_checks || ! check_backup_restore; then
    show_logs
    exit 1
  fi
  exit 0
fi

printf '\nPreview ready\n'
printf '  URL:      https://%s:%s\n' "$dev_web_hostname" "$dev_https_port"
printf '  Username: %s\\%s\n' "$dev_workgroup" "$dev_admin_user"
printf '  Password: %s\n' "$dev_admin_password"
printf '  CA root:  %s\n' "$ca_root_file"
printf '\nThe CA is disposable, so import the displayed root only as temporary trust.\n'
printf 'SMB activity and backups repeat in the background. Press Ctrl-C to remove everything.\n\n'

follow_server
